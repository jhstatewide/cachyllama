#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require

// DeepSeek-V4 Lightning Indexer.
//
// Per (i_batch, i_stream, i_kv):
//   score = sum_h max(0, sum_j q[b, h, j] * k[i, j]) * w[b, h]
//   dst[i_kv, i_batch, i_stream] = score + m[i_kv, i_batch, i_stream % nem3]
//
// Layout (matches ggml_lightning_indexer in ggml.c):
//   q: [n_embd=128, n_head, n_batch, n_stream]   strides nbq0, nbq1, nbq2
//   k: [n_embd=128,      1, n_kv,    n_stream]   strides nbk2, nbk3
//   w: [n_head,          n_batch, 1, n_stream]   strides nbw0, nbw1
//   m: [n_kv,            n_batch, 1, nem3]       strides nbm0, nbm1, nbm3
//   d: [n_kv,            n_batch, 1, n_stream]   strides nbd0, nbd1, nbd3
//
// Workgroup geometry: one warp covers one K vector (32 lanes * 4 elems = 128).
// WARPS_PER_BLOCK warps per block, each owning K_VECS_PER_WARP K vectors.
// K is dequantized once into shared memory and reused across N_HEAD heads.

layout(constant_id = 0) const uint N_EMBD            = 128;
// N_HEAD_MAX bounds the q_shared allocation; the per-head loop and Q load
// use p.n_head (a push constant) so we support both nh=32 and nh=64 inputs
// without two shader variants. The supports_op gate in ggml-vulkan.cpp
// restricts to {32, 64}, so 64 is the only bound we need to handle.
layout(constant_id = 1) const uint N_HEAD_MAX        = 64;
// WARPS_PER_BLOCK is a compile-time constant of 4 (not a spec constant) because
// glslang emits local_size_y_id = 2 as a literal default of 1 in OpExecutionMode,
// not as a real spec constant binding (the WorkgroupSize builtin would track the
// override but the workgroup size is fixed by LocalSize). Hardcoding 4 keeps the
// K_VECS_PER_BLOCK = WARPS_PER_BLOCK * K_VECS_PER_WARP math consistent with the
// actual 32x4x1 = 128-thread workgroup.
const uint WARPS_PER_BLOCK             = 4;
layout(constant_id = 3) const uint K_VECS_PER_WARP   = 8;

const uint K_VECS_PER_BLOCK  = K_VECS_PER_WARP * WARPS_PER_BLOCK;
const uint THREADS_PER_BLOCK = WARPS_PER_BLOCK * 32u;
const uint ELEMS_PER_LANE    = N_EMBD / 32u;

layout(local_size_x = 32, local_size_y = 4, local_size_z = 1) in;

layout(push_constant) uniform parameter
{
    uint n_embd;
    uint n_head;
    uint n_batch;
    uint n_stream;
    uint n_kv;
    uint nem3;

    uint nbq0; uint nbq1; uint nbq2;
    uint nbq3;
    uint nbk2; uint nbk3;
    uint nbw0; uint nbw1; uint nbw3;
    uint nbm0; uint nbm1; uint nbm3;
    uint nbd0; uint nbd1; uint nbd3;

    uint q_offset;
    uint k_offset;
    uint w_offset;
    uint m_offset;
    uint d_offset;

    uint k_type_id; // ggml_type enum value: F32/F16/Q4_0/Q4_1/Q5_0/Q5_1/Q8_0/IQ4_NL
} p;

layout(binding = 0, std430) readonly buffer Q { float data_q[]; };
layout(binding = 1, std430) readonly buffer K { uint8_t data_k[]; };
layout(binding = 2, std430) readonly buffer W { float data_w[]; };
layout(binding = 3, std430) readonly buffer M { float16_t data_m[]; };
layout(binding = 4, std430) writeonly buffer D { float data_d[]; };

// q_shared is sized for the maximum N_HEAD the dispatch can request (see
// N_HEAD_MAX spec constant above). The Q load and per-head loop use the
// runtime p.n_head so nh=32 and nh=64 inputs both work.
shared float q_shared[N_HEAD_MAX * N_EMBD];
shared float k_shared[K_VECS_PER_BLOCK * N_EMBD];

struct block_q4_0   { float16_t d; uint8_t  qs[16]; };
struct block_q4_1   { float16_t d; float16_t m; uint8_t qs[16]; };
struct block_q5_0   { float16_t d; uint16_t qh[2]; uint8_t qs[16]; };
struct block_q5_1   { float16_t d; float16_t m; uint qh; uint8_t qs[16]; };
struct block_q8_0   { float16_t d; int8_t   qs[32]; };
struct block_iq4_nl { float16_t d; uint8_t  qs[16]; };

const int8_t kvalues_iq4nl_const[16] = int8_t[](
    int8_t(-127), int8_t(-104), int8_t(-83), int8_t(-65),
    int8_t(-49),  int8_t(-35),  int8_t(-22), int8_t(-10),
    int8_t(1),    int8_t(13),   int8_t(25),  int8_t(38),
    int8_t(53),   int8_t(69),   int8_t(89),  int8_t(113));
shared float iq4nl_table[16];

void init_iq4nl_table() {
    for (uint i = gl_LocalInvocationIndex; i < 16; i += THREADS_PER_BLOCK) {
        iq4nl_table[i] = float(kvalues_iq4nl_const[i]);
    }
    barrier();
}

float load_k_element(uint i_kv, uint i_stream, uint j) {
    const uint byte_base = p.k_offset + i_kv * p.nbk2 + i_stream * p.nbk3;

    if (p.k_type_id == 0u) { // GGML_TYPE_F32
        // F32: 4 bytes per element, little-endian. Read all 4 bytes and
        // reinterpret as a float via uintBitsToFloat.
        const uint b0 = uint(data_k[byte_base + j * 4u]);
        const uint b1 = uint(data_k[byte_base + j * 4u + 1u]);
        const uint b2 = uint(data_k[byte_base + j * 4u + 2u]);
        const uint b3 = uint(data_k[byte_base + j * 4u + 3u]);
        return uintBitsToFloat(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24));
    } else if (p.k_type_id == 1u) { // GGML_TYPE_F16
        // Reinterpret two bytes as a float16_t and convert to float.
        // Build the raw 16-bit value then convert via unpackHalf2x16.
        const uint lo = uint(data_k[byte_base + j * 2u]);
        const uint hi = uint(data_k[byte_base + j * 2u + 1u]);
        return float(unpackHalf2x16(lo | (hi << 8u)).x);
    } else if (p.k_type_id == 30u) { // GGML_TYPE_BF16
        // BF16 is the upper 16 bits of IEEE-754 float32. Read 2 bytes,
        // build a uint16, shift into the high half of a uint32, then
        // reinterpret as float. No extension required.
        const uint lo = uint(data_k[byte_base + j * 2u]);
        const uint hi = uint(data_k[byte_base + j * 2u + 1u]);
        return uintBitsToFloat((lo | (hi << 8u)) << 16u);
    } else if (p.k_type_id == 2u) { // GGML_TYPE_Q4_0
        // block_q4_0 = {float16_t d; uint8_t qs[16];} -> 18 bytes packed.
        // Read scalar fields directly without pointer casting (glslang rejects
        // cast of byte-pointer to struct-with-float16).
        // Layout: low nibble of qs[i] -> element i (0..15),
        //         high nibble of qs[i] -> element i+16 (16..31).
        const uint byte_base_blk = byte_base + (j / 32u) * 18u;
        const uint off = j % 32u;
        const float d = float(unpackHalf2x16(uint(data_k[byte_base_blk]) | (uint(data_k[byte_base_blk + 1u]) << 8u)).x);
        const uint j_in_block = off & 15u;
        const uint high      = off >> 4u;
        const uint v = (uint(data_k[byte_base_blk + 2u + j_in_block]) >> (high * 4u)) & 0xFu;
        return d * float(int(v) - 8);
    } else if (p.k_type_id == 3u) { // GGML_TYPE_Q4_1
        // block_q4_1 = {float16_t d; float16_t m; uint8_t qs[16];} -> 20 bytes.
        // Same nibble layout as Q4_0.
        const uint byte_base_blk = byte_base + (j / 32u) * 20u;
        const uint off = j % 32u;
        const float d = float(unpackHalf2x16(uint(data_k[byte_base_blk]) | (uint(data_k[byte_base_blk + 1u]) << 8u)).x);
        const float m = float(unpackHalf2x16(uint(data_k[byte_base_blk + 2u]) | (uint(data_k[byte_base_blk + 3u]) << 8u)).x);
        const uint j_in_block = off & 15u;
        const uint high      = off >> 4u;
        const uint v = (uint(data_k[byte_base_blk + 4u + j_in_block]) >> (high * 4u)) & 0xFu;
        return d * float(v) + m;
    } else if (p.k_type_id == 6u) { // GGML_TYPE_Q5_0
        // block_q5_0 = {float16_t d; uint8_t qh[4]; uint8_t qs[16];} -> 2+4+16 = 22 bytes.
        // qh is a 32-bit field; bit i corresponds to element i (low 16 bits = low half,
        // high 16 bits = high half). CPU and CUDA references both compute xh = bit off of qh
        // (the ((x >> n) << 4) & 0x10 form for the low half, the ((x >> n) & 0x10) form for
        // the high half; both extract the same bit). qs nibble layout matches Q4_0.
        const uint byte_base_blk = byte_base + (j / 32u) * 22u;
        const uint off = j % 32u;
        const float d = float(unpackHalf2x16(uint(data_k[byte_base_blk]) | (uint(data_k[byte_base_blk + 1u]) << 8u)).x);
        const uint qh_lo = uint(data_k[byte_base_blk + 2u]) | (uint(data_k[byte_base_blk + 3u]) << 8u);
        const uint qh_hi = uint(data_k[byte_base_blk + 4u]) | (uint(data_k[byte_base_blk + 5u]) << 8u);
        const uint uint_qh = qh_lo | (qh_hi << 16u);
        const uint qh = ((uint_qh >> off) << 4u) & 0x10u;
        const uint j_in_block = off & 15u;
        const uint high      = off >> 4u;
        const uint v = ((uint(data_k[byte_base_blk + 6u + j_in_block]) >> (high * 4u)) & 0xFu) | qh;
        return d * float(int(v) - 16);
    } else if (p.k_type_id == 7u) { // GGML_TYPE_Q5_1
        // block_q5_1 = {float16_t d; float16_t m; uint qh; uint8_t qs[16];} -> 4+4+4+16 = 28? Actually = 24 bytes.
        // Same qh bit + qs nibble layout as Q5_0.
        const uint byte_base_blk = byte_base + (j / 32u) * 24u;
        const uint off = j % 32u;
        const float d = float(unpackHalf2x16(uint(data_k[byte_base_blk]) | (uint(data_k[byte_base_blk + 1u]) << 8u)).x);
        const float m = float(unpackHalf2x16(uint(data_k[byte_base_blk + 2u]) | (uint(data_k[byte_base_blk + 3u]) << 8u)).x);
        const uint qh = (uint(data_k[byte_base_blk + 4u]) |
                         (uint(data_k[byte_base_blk + 5u]) << 8u) |
                         (uint(data_k[byte_base_blk + 6u]) << 16u) |
                         (uint(data_k[byte_base_blk + 7u]) << 24u));
        const uint qhbit = ((qh >> off) << 4u) & 0x10u;
        const uint j_in_block = off & 15u;
        const uint high      = off >> 4u;
        const uint v = ((uint(data_k[byte_base_blk + 8u + j_in_block]) >> (high * 4u)) & 0xFu) | qhbit;
        return d * float(v) + m;
    } else if (p.k_type_id == 8u) { // GGML_TYPE_Q8_0
        // block_q8_0 = {float16_t d; int8_t qs[32];} -> 2+32 = 34 bytes.
        // qs is signed: byte 0x80 (128 unsigned) = -128 signed. GLSL's
        // int(...) cast from uint8 is a bitcast (unsigned interpretation),
        // so we sign-extend by subtracting 256 when the byte is >= 128.
        const uint byte_base_blk = byte_base + (j / 32u) * 34u;
        const uint off = j % 32u;
        const float d = float(unpackHalf2x16(uint(data_k[byte_base_blk]) | (uint(data_k[byte_base_blk + 1u]) << 8u)).x);
        const uint q_u = uint(data_k[byte_base_blk + 2u + off]);
        const int q = int(q_u) - 256 * int(q_u >> 7u);
        return d * float(q);
    } else { // GGML_TYPE_IQ4_NL == 20
        // block_iq4_nl = {float16_t d; uint8_t qs[16];} -> 18 bytes.
        // Same nibble layout as Q4_0 with a 16-entry iq4nl_table lookup.
        const uint byte_base_blk = byte_base + (j / 32u) * 18u;
        const uint off = j % 32u;
        const float d = float(unpackHalf2x16(uint(data_k[byte_base_blk]) | (uint(data_k[byte_base_blk + 1u]) << 8u)).x);
        const uint j_in_block = off & 15u;
        const uint high      = off >> 4u;
        const uint v = (uint(data_k[byte_base_blk + 2u + j_in_block]) >> (high * 4u)) & 0xFu;
        return d * iq4nl_table[v];
    }
}

void main() {
    const uint i_warp = gl_LocalInvocationID.y;
    const uint i_lane = gl_LocalInvocationID.x;
    const uint tid    = i_warp * 32u + i_lane;

    if (p.k_type_id == 20u) {
        init_iq4nl_table();
    }

    const uint i_batch  = gl_WorkGroupID.y;
    const uint i_stream = gl_WorkGroupID.z;
    const uint start_kv_block = gl_WorkGroupID.x * K_VECS_PER_BLOCK;
    const uint start_kv       = start_kv_block + i_warp * K_VECS_PER_WARP;

    // Phase 1: load Q into shared memory.
    {
        // Only load p.n_head heads; q_shared's tail (for unused heads if any)
        // is left zero but never read because the head loop bounds to p.n_head.
        const uint total = p.n_head * N_EMBD;
        for (uint i = tid; i < total; i += THREADS_PER_BLOCK) {
            const uint h = i / N_EMBD;
            const uint j = i % N_EMBD;
            // Q is per-stream on ne[3] (CPU reference reads q[h, batch, s]).
            const uint q_idx = p.q_offset + j * p.nbq0 + h * p.nbq1 + i_batch * p.nbq2 + i_stream * p.nbq3;
            q_shared[i] = data_q[q_idx];
        }
    }

    // Phase 2: dequantize K for this block's K vectors into shared memory.
    {
        const uint total = K_VECS_PER_BLOCK * N_EMBD;
        for (uint i = tid; i < total; i += THREADS_PER_BLOCK) {
            const uint local_kv = i / N_EMBD;
            const uint j        = i % N_EMBD;
            const uint i_kv     = start_kv_block + local_kv;
            float v;
            if (i_kv < p.n_kv && j < p.n_embd) {
                v = load_k_element(i_kv, i_stream, j);
            } else {
                v = 0.0f;
            }
            k_shared[i] = v;
        }
    }

    barrier();

    // Phase 3: per-head dot products + ReLU + weighted accumulation.
    float score_k[K_VECS_PER_WARP];
    for (uint k = 0; k < K_VECS_PER_WARP; ++k) {
        score_k[k] = 0.0f;
    }

    for (uint h = 0; h < p.n_head; ++h) {
        // W is per-stream on ne[3]; the CPU reference picks w[h, batch, s].
        const float w_val = data_w[p.w_offset + h * p.nbw0 + i_batch * p.nbw1 + i_stream * p.nbw3];

        for (uint k = 0; k < K_VECS_PER_WARP; ++k) {
            float dot = 0.0f;
            const uint k_base = (i_warp * K_VECS_PER_WARP + k) * N_EMBD;
            const uint q_base = h * N_EMBD;
            for (uint j = 0; j < ELEMS_PER_LANE; ++j) {
                dot = fma(q_shared[q_base + i_lane * ELEMS_PER_LANE + j],
                          k_shared[k_base + i_lane * ELEMS_PER_LANE + j],
                          dot);
            }
            dot = subgroupAdd(dot);
            dot = max(dot, 0.0f) * w_val;
            score_k[k] += dot;
        }
    }

    // Phase 4: write dst[i_kv, i_batch, i_stream] = score + m[i_kv, i_batch, i_stream % nem3].
    for (uint k = 0; k < K_VECS_PER_WARP; ++k) {
        const uint i_kv = start_kv + k;
        if (i_kv < p.n_kv) {
            const float m_val = float(data_m[p.m_offset + i_kv * p.nbm0 + i_batch * p.nbm1 + (i_stream % p.nem3) * p.nbm3]);
            const uint d_idx = p.d_offset + i_kv * p.nbd0 + i_batch * p.nbd1 + i_stream * p.nbd3;
            data_d[d_idx] = score_k[k] + m_val;
        }
    }
}